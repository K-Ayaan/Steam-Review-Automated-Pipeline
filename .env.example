# Copy to .env and fill in. Never commit .env.

# Gemini (ad generation)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Ollama (review analysis). Code default is qwen2.5:7b;
# set to the tag you actually have installed (see `ollama list`).
OLLAMA_MODEL=qwen2.5:7b-instruct

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-id/your-token

# Reddit (script app: https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your-client-id
REDDIT_CLIENT_SECRET=your-client-secret
REDDIT_USERNAME=your-reddit-username
REDDIT_PASSWORD=your-reddit-password
REDDIT_USER_AGENT=steam-ad-review/1.0 by your-reddit-username
REDDIT_SUBREDDIT=your_test_subreddit

# Email (SMTP). Host is your provider's server, e.g. smtp.gmail.com.
# Port 587 = STARTTLS, 465 = implicit SSL. Gmail needs an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=you@example.com
SMTP_USE_TLS=true
EMAIL_RECIPIENTS=first@example.com,second@example.com

# PostgreSQL (docker compose). Runs are mirrored into it when DATABASE_URL is set;
# JSON files in outputs/ stay the source of truth.
POSTGRES_USER=steam
POSTGRES_PASSWORD=change-me
POSTGRES_DB=steam_ads
POSTGRES_PORT=5432
DATABASE_URL=postgresql://steam:change-me@localhost:5432/steam_ads

# n8n (docker compose) and the pipeline trigger API it calls
N8N_ENCRYPTION_KEY=generate-a-long-random-string
GENERIC_TIMEZONE=UTC
PIPELINE_API_TOKEN=generate-another-long-random-string
PIPELINE_API_URL=http://host.docker.internal:8001
